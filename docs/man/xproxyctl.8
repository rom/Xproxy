T{
\fBapikey\fR \fBadd\fR|\:\fBrotate\fR|\:\fBrevoke\fR|\:\fBremove\fR|\:\fBlist\fR [*ID*] [\fB\-\:file\fR \fIPATH\fR] [\fB\-\:scopes\fR \fIA,B\fR] [\fB\-\:expires\fR \fI90d\fR] [\fB\-\:note\fR \fITEXT\fR] [\fB\-\:grace\fR \fI24h\fR]
