.SH "EXIT STATUS"
.PP
0 on success; 1 when the daemon reports an error or cannot be reached; 2 on a usage error. \fBdiff\fR exits 1 when the two configurations differ. \fBready\fR exits 0 when this node should carry traffic, 1 when it should not, and 2 when the daemon could not be asked \[u2014] a check script must keep the last two apart, or it will move a shared address because a socket became unreadable.
.SH "FILES"
.PP
\fB/run/xproxy/mgmt.sock\fR, \fB/etc/xproxy/xproxy.yaml\fR.
.SH "EXAMPLES"
.PP
.RS 4
.nf
.ft CR
xproxyctl status
xproxyctl \-json stats | jq .denied_rate_limit
xproxyctl tail security | jq \-c '{t:.time, ip:.client_ip, r:.reason}'
xproxyctl reload \-dry\-run
xproxyctl ready \-step\-down "kernel update" && systemctl restart xproxy
xproxyctl ready \-require\-upstreams; echo $?
xproxyctl ban \-duration 24h \-reason "credential stuffing" 203.0.113.0/24
xproxyctl rotate\-secret /var/lib/xproxy/challenge.key && xproxyctl reload
xproxyctl completion bash > /etc/bash_completion.d/xproxyctl
.ft
.fi
.RE
