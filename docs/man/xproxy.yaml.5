    allow_clients: ["10.0.4.0/24"]
    allow_users: [reporting, dashboards]
    allow_databases: [sales]
    allow_auth: [scram]
    read_only: true
    allow_statements: [select, explain, show, set, begin, commit, rollback, fetch, declare, close_cursor]
.ft
.fi
.RE
.PP
