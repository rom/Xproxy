lbw(1.6i) lbx
lw(1.6i) lx.
T{
Element
T}	T{
Meaning
T}
T{
\fBa && b\fR,\: \fBa and b\fR,\: \fBa || b\fR,\: \fBa or b\fR,\: \fB!a\fR,\: \fBnot a\fR,\: \fB(a)\fR
T}	T{
Boolean operators,\: lowest precedence first: or,\: and,\: not
T}
