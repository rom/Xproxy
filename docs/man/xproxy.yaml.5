\fBclient_\:ip\fR,\: \fBhost\fR,\: \fBpath\fR,\: \fBraw_\:query\fR,\: \fBmethod\fR,\: \fBscheme\fR,\: \fBcountry\fR,\: \fBja4\fR,\: \fBtls_\:version\fR,\: \fBtls_\:cipher\fR,\: \fBrequest_\:id\fR,\: \fBroute\fR,\: \fBupstream\fR,\: \fBtenant\fR,\: \fBtime\fR,\: \fBdate\fR,\: \fBhour\fR,\: \fBminute\fR,\: \fBweekday\fR
