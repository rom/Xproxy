T{
\fBdeny\fR
T}	T{
list of CIDR
T}	T{
\fB[]\fR
T}	T{
Further ranges to refuse,\: in either family
T}
T{
\fBallow\fR
T}	T{
list of CIDR
T}	T{
\fB[]\fR
T}	T{
