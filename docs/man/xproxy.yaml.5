T}	T{
\fBhost_\:cidrs:\: ["198.\:51.\:100.\:0/\:24",\: "2001:\:db8:\:1:\::\:/\:48"]\fR
T}
T{
Every address literal,\: whatever the range
T}	T{
\fBhost_\:cidrs:\: ["0.\:0.\:0.\:0/\:0",\: ":\::\:/\:0"]\fR
T}
T{
Every host,\: name or address
T}	T{
no host selector at all
T}
T{
