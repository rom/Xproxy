# xproxy-admin: the web GUI. A separate process from the data plane; it
# talks to /run/xproxy/mgmt.sock and serves on the loopback address only.
# Reach it through an SSH tunnel (ssh -L 8443:127.0.0.1:8443 host), or bind
# it to an internal address with -tls-cert, -tls-key and -client-ca.
#
# Install:  cp xproxy-admin.service /etc/systemd/system/
#           useradd -r -g xproxy -s /sbin/nologin xproxy-admin
#           chown xproxy-admin:xproxy /etc/xproxy/xproxy.yaml && chmod 0640 /etc/xproxy/xproxy.yaml
#           xproxy-admin user add admin -role operator
#           systemctl daemon-reload && systemctl enable --now xproxy-admin
[Unit]
Description=xproxy web GUI
Documentation=https://github.com/rom/xproxy/tree/main/docs
After=xproxy.service
Wants=xproxy.service

[Service]
Type=simple
User=xproxy-admin
Group=xproxy
ExecStart=/usr/local/bin/xproxy-admin serve -listen 127.0.0.1:8443 -socket /run/xproxy/mgmt.sock -config /etc/xproxy/xproxy.yaml -users /etc/xproxy/admin-users -restart-cmd "systemctl restart xproxy.service"
Restart=on-failure
RestartSec=2s
UMask=0027

# Sandboxing. The GUI writes the configuration file (owned by xproxy-admin)
# and the users file, reads the logs, and runs systemctl for the restart
# action, which polkit authorises through 50-xproxy-admin.rules.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private
PrivateMounts=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @reboot @swap @obsolete @cpu-emulation @debug @module @raw-io
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/etc/xproxy
ReadOnlyPaths=/var/log/xproxy /run/xproxy
IPAddressAllow=localhost
IPAddressDeny=any
DevicePolicy=closed

[Install]
WantedBy=multi-user.target
