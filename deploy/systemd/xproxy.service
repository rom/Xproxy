# xproxy data plane. Pairs with xproxy.socket for socket activation so the
# service never needs root or CAP_NET_BIND_SERVICE.
#
# Install:  cp xproxy.service xproxy.socket /etc/systemd/system/
#           systemctl daemon-reload && systemctl enable --now xproxy.socket
[Unit]
Description=xproxy secure reverse proxy
Documentation=https://github.com/rom/xproxy/tree/main/docs
After=network-online.target
Wants=network-online.target
Requires=xproxy.socket

[Service]
Type=notify
User=xproxy
Group=xproxy
ExecStart=/usr/local/bin/xproxy -config /etc/xproxy/xproxy.yaml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2s
TimeoutStopSec=45s
KillSignal=SIGTERM
LimitNOFILE=1048576
UMask=0027

# Directories managed by systemd (created with the right owner and label).
ConfigurationDirectory=xproxy
ConfigurationDirectoryMode=0750
LogsDirectory=xproxy
LogsDirectoryMode=0750
RuntimeDirectory=xproxy
RuntimeDirectoryMode=0750
StateDirectory=xproxy
StateDirectoryMode=0700

# Sandboxing. Every directive here is verified by `systemd-analyze security`.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=no
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @reboot @swap @obsolete @cpu-emulation @debug @module @raw-io
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
ReadOnlyPaths=/etc/xproxy
ReadWritePaths=/var/log/xproxy /run/xproxy /var/lib/xproxy
IPAddressDeny=
DevicePolicy=closed

[Install]
WantedBy=multi-user.target
