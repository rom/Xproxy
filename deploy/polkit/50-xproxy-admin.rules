// Allow the xproxy-admin service user to restart the data plane through
// systemd, and nothing else. Install to /etc/polkit-1/rules.d/.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "xproxy.service" &&
        action.lookup("verb") == "restart" &&
        subject.user == "xproxy-admin") {
        return polkit.Result.YES;
    }
});
