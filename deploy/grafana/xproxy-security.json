  "annotations": {
    "list": [
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "enable": true,
        "expr": "changes(xproxy_config_generation{instance=~\"$instance\"}[1m]) > 0",
        "iconColor": "blue",
        "name": "Reloads",
        "step": "1m",
        "titleFormat": "configuration reload"
      }
    ]
  },
  "description": "Denied requests, WAF activity, bans, challenges, rate limits, honeypots and log delivery of Xproxy nodes (shipped with the product, deploy/grafana).",
