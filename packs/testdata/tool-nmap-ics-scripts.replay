# tool-nmap-ics-scripts -- Nmap's control-protocol scripts, across kinds
# The sequence this pack is about. Each line is one security event:
#   <listener kind> <action> <reason>
# fire: the whole sequence, which must report.
# hold: the same sequence one signal short, which must not.
fire
  bacnet alert anomaly_new_talker
  coap alert anomaly_new_pair
  modbus alert anomaly_new_pair
  modbus alert anomaly_new_pair
  modbus alert anomaly_new_pair
hold
  modbus alert anomaly_new_talker
